# Hurl test file generated by Apinox
# API: atomix-cloud-api v1.0.0
# Atomix Cloud — self-hosted PaaS platform API (GitHub OAuth, projects, deployments, databases, domains)
# Base URL: https://cloud.denisetiya.site/api

### Authentication ###

# Endpoint: Initiate GitHub OAuth
# Redirect to GitHub OAuth consent screen. Returns 302 to github.com/login/oauth/authorize.
# GET /auth/github
GET https://cloud.denisetiya.site/api/auth/github
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 302

# Endpoint: GitHub OAuth Callback
# GitHub redirects here with ?code=xxx. Exchanges code for token, creates/updates user, returns JWT.
# GET /auth/github/callback
GET https://cloud.denisetiya.site/api/auth/github/callback
[QueryStringParams]
code: 
state: 
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.token" exists
[Assert]
jsonpath "$.user" exists

# Endpoint: Get Current User
# Get authenticated user profile from JWT token.
# GET /auth/me
GET https://cloud.denisetiya.site/api/auth/me
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.username" exists
[Assert]
jsonpath "$.github_id" exists
[Assert]
jsonpath "$.email" exists
[Assert]
jsonpath "$.avatar_url" exists
[Assert]
jsonpath "$.created_at" exists
[Assert]
jsonpath "$.id" exists

# Endpoint: Logout
# Invalidate current JWT session.
# POST /auth/logout
POST https://cloud.denisetiya.site/api/auth/logout
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.message" exists

# Endpoint: List User GitHub Repos
# List authenticated user's GitHub repositories (via GitHub API with user's token).
# GET /auth/github/repos
GET https://cloud.denisetiya.site/api/auth/github/repos
[QueryStringParams]
page: 1
per_page: 30
sort: "updated"
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.name" exists
[Assert]
jsonpath "$.clone_url" exists
[Assert]
jsonpath "$.description" exists
[Assert]
jsonpath "$.default_branch" exists
[Assert]
jsonpath "$.private" exists
[Assert]
jsonpath "$.full_name" exists
[Assert]
jsonpath "$.language" exists

### Deployments ###

# Endpoint: Trigger Deployment
# Trigger a new deployment. Pulls latest code, builds, and deploys.
# POST /projects/{id}/deploy
POST https://cloud.denisetiya.site/api/projects/{id}/deploy
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 201
[Assert]
jsonpath "$.created_at" exists
[Assert]
jsonpath "$.project_id" exists
[Assert]
jsonpath "$.status" exists
[Assert]
jsonpath "$.commit_sha" exists
[Assert]
jsonpath "$.id" exists
[Assert]
jsonpath "$.build_logs" exists
[Assert]
jsonpath "$.finished_at" exists
[Assert]
jsonpath "$.deploy_logs" exists
[Assert]
jsonpath "$.commit_message" exists
[Assert]
jsonpath "$.branch" exists

# Endpoint: List Deployments
# List all deployments for a project, newest first.
# GET /projects/{id}/deployments
GET https://cloud.denisetiya.site/api/projects/{id}/deployments
[QueryStringParams]
page: 1
per_page: 20
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.total" exists

# Endpoint: Get Deployment
# Get single deployment details.
# GET /deployments/{id}
GET https://cloud.denisetiya.site/api/deployments/{id}
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.deploy_logs" exists
[Assert]
jsonpath "$.created_at" exists
[Assert]
jsonpath "$.id" exists
[Assert]
jsonpath "$.finished_at" exists
[Assert]
jsonpath "$.project_id" exists
[Assert]
jsonpath "$.branch" exists
[Assert]
jsonpath "$.commit_message" exists
[Assert]
jsonpath "$.commit_sha" exists
[Assert]
jsonpath "$.status" exists
[Assert]
jsonpath "$.build_logs" exists

# Endpoint: Get Deployment Logs
# Get build and deploy logs for a deployment.
# GET /deployments/{id}/logs
GET https://cloud.denisetiya.site/api/deployments/{id}/logs
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.deploy_logs" exists
[Assert]
jsonpath "$.build_logs" exists

### Projects ###

# Endpoint: List Projects
# List all projects for authenticated user.
# GET /projects
GET https://cloud.denisetiya.site/api/projects
[QueryStringParams]
page: 1
per_page: 20
[Headers]
Authorization: Bearer {{token}}
[Assert]
status == 200
[Assert]
jsonpath "$.per_page" exists
[Assert]
jsonpath "$.page" exists
[Assert]
jsonpath "$.total" exists

# Endpoint: Create Project
# Create a new project from a GitHub repository. Clones repo, detects framework, triggers first deploy.
# POST /projects
POST https://cloud.denisetiya.site/api/projects
[Headers]
Authorization: Bearer {{token}}
[Body]
```json
{
  "name": "atomix-cloud",
  "repo_branch": "main",
  "repo_url": "https://github.com/denisetiya/atomix-cloud.git"
}
```
[Assert]
status == 201
[Assert]
jsonpath "$.repo_url" exists
[Assert]
jsonpath "$.framework" exists
[Assert]
jsonpath "$.repo_branch" exists
[Assert]
jsonpath "$.created_at" exists
[Assert]
jsonpath "$.name" exists
[Assert]
jsonpath "$.language" exists
[Assert]
jsonpath "$.updated_at" exists
[Assert]
jsonpath "$.port" exists
[Assert]
jsonpath "$.status" exists
[Assert]
jsonpath "$.id" exists

